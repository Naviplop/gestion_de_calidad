generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Standard {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                 @unique @db.VarChar(50)
  name              String                 @db.VarChar(200)
  description       String?
  version           String?                @db.VarChar(20)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(6)
  organizationLinks OrganizationStandard[]
  requirements      StandardRequirement[]

  @@map("standards")
}

model StandardRequirement {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standardId          String                  @db.Uuid
  code                String                  @db.VarChar(50)
  title               String                  @db.VarChar(300)
  description         String?
  clause              String?                 @db.VarChar(50)
  parentRequirementId String?                 @db.Uuid
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  auditChecklistItems AuditChecklistItem[]
  findings            AuditFinding[]
  processLinks        ProcessRequirementMap[]
  parentRequirement   StandardRequirement?    @relation("RequirementHierarchy", fields: [parentRequirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childRequirements   StandardRequirement[]   @relation("RequirementHierarchy")
  standard            Standard                @relation(fields: [standardId], references: [id], onDelete: Cascade)

  @@unique([standardId, code])
  @@map("standard_requirements")
}

model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource        String           @db.VarChar(100)
  action          String           @db.VarChar(100)
  description     String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model Organization {
  id                            String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                          String                         @db.VarChar(200)
  taxId                         String?                        @db.VarChar(50)
  email                         String?                        @db.VarChar(200)
  phone                         String?                        @db.VarChar(50)
  address                       String?
  timezone                      String                         @default("UTC") @db.VarChar(50)
  locale                        String                         @default("es") @db.VarChar(10)
  logoUrl                       String?
  primaryColor                  String?                        @db.VarChar(7)
  isActive                      Boolean                        @default(true)
  createdAt                     DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                       @updatedAt @db.Timestamptz(6)
  actionEvidences               ActionEvidence[]
  areas                         Area[]
  auditChecklists               AuditChecklist[]
  auditEvidences                AuditEvidence[]
  auditFindings                 AuditFinding[]
  auditLogs                     AuditLog[]
  auditPrograms                 AuditProgram[]
  audits                        Audit[]
  correctiveActionVerifications CorrectiveActionVerification[]
  correctiveActions             CorrectiveAction[]
  departments                   Department[]
  documentAcknowledgements      DocumentAcknowledgement[]
  documentApprovals             DocumentApproval[]
  distributions                 DocumentDistribution[]
  documentReviewers             DocumentReviewer[]
  documentVersions              DocumentVersion[]
  documents                     Document[]
  electronicSignatures          ElectronicSignatureEvent[]
  fileAssets                    FileAsset[]
  indicatorMeasurements         IndicatorMeasurement[]
  indicators                    Indicator[]
  nonconformities               Nonconformity[]
  notificationPreferences       NotificationPreference[]
  notifications                 Notification[]
  settings                      OrganizationSetting[]
  standards                     OrganizationStandard[]
  processRequirementMaps        ProcessRequirementMap[]
  processes                     Process[]
  riskAssessments               RiskAssessment[]
  riskControls                  RiskControl[]
  riskTreatments                RiskTreatment[]
  risks                         Risk[]
  roles                         Role[]
  rootCauseAnalyses             RootCauseAnalysis[]
  trainingCourses               TrainingCourse[]
  trainingEvidences             TrainingEvidence[]
  trainingSessions              TrainingSession[]
  users                         User[]
  securityEvents                SecurityEvent[]
  idempotencyKeys               IdempotencyKey[]

  @@map("organizations")
}

model OrganizationSetting {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  key            String       @db.VarChar(100)
  value          Json         @default("{}") @db.Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model OrganizationStandard {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  standardId     String       @db.Uuid
  adoptedAt      DateTime?    @db.Date
  isActive       Boolean      @default(true)
  configuration  Json         @default("{}") @db.Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard       Standard     @relation(fields: [standardId], references: [id])

  @@unique([organizationId, standardId])
  @@map("organization_standards")
}

model Department {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                 @db.Uuid
  name               String                 @db.VarChar(150)
  description        String?
  parentDepartmentId String?                @db.Uuid
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment   Department?            @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childDepartments   Department[]           @relation("DepartmentHierarchy")
  distributions      DocumentDistribution[]
  documents          Document[]
  users              User[]

  @@unique([organizationId, name])
  @@map("departments")
}

model User {
  id                         String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId             String                         @db.Uuid
  email                      String                         @db.VarChar(200)
  passwordHash               String                         @db.VarChar(255)
  firstName                  String                         @db.VarChar(100)
  lastName                   String                         @db.VarChar(100)
  departmentId               String?                        @db.Uuid
  mfaEnabled                 Boolean                        @default(false)
  mfaSecret                  String?                        @db.VarChar(255)
  mfaBackupCodes             Json?                          @db.Json
  lastLoginAt                DateTime?                      @db.Timestamptz(6)
  lastLoginIp                String?                        @db.VarChar(45)
  isActive                   Boolean                        @default(true)
  isLocked                   Boolean                        @default(false)
  failedLoginAttempts        Int                            @default(0)
  lockedUntil                DateTime?                      @db.Timestamptz(6)
  createdAt                  DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                       @updatedAt @db.Timestamptz(6)
  deletedAt                  DateTime?                      @db.Timestamptz(6)
  actionEvidence             ActionEvidence[]
  managedAreas               Area[]
  auditEvidence              AuditEvidence[]
  identifiedFindings         AuditFinding[]                 @relation("FindingIdentifier")
  auditLogs                  AuditLog[]                     @relation("AuditActor")
  managedAuditPrograms       AuditProgram[]
  leadAudits                 Audit[]                        @relation("AuditLead")
  verifications              CorrectiveActionVerification[] @relation("VerificationPerformer")
  correctiveActions          CorrectiveAction[]
  documentAcknowledgements   DocumentAcknowledgement[]
  documentApprovals          DocumentApproval[]
  assignedDistributions      DocumentDistribution[]
  documentReviewers          DocumentReviewer[]
  approvedDocumentVersions   DocumentVersion[]              @relation("DocumentVersionApprover")
  createdDocumentVersions    DocumentVersion[]              @relation("DocumentVersionCreator")
  createdDocuments           Document[]                     @relation("DocumentCreator")
  ownedDocuments             Document[]                     @relation("DocumentOwner")
  responsibleDocuments       Document[]                     @relation("DocumentResponsible")
  updatedDocuments           Document[]                     @relation("DocumentUpdater")
  electronicSignatures       ElectronicSignatureEvent[]
  uploadedFiles              FileAsset[]                    @relation("FileUploader")
  indicatorMeasurements      IndicatorMeasurement[]
  responsibleIndicators      Indicator[]                    @relation("IndicatorResponsible")
  mfaCredential              MfaCredential?
  mfaRecoveryCodes           MfaRecoveryCode[]
  closedNonconformities      Nonconformity[]                @relation("NonconformityClosedBy")
  responsibleNonconformities Nonconformity[]                @relation("NonconformityResponsible")
  notificationPreferences    NotificationPreference[]
  notifications              Notification[]
  ownedProcesses             Process[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  assessments                RiskAssessment[]
  riskControls               RiskControl[]
  treatments                 RiskTreatment[]                @relation("RiskTreatmentResponsible")
  risks                      Risk[]                         @relation("RiskOwner")
  rootCauseAnalyses          RootCauseAnalysis[]
  trainingParticipants       TrainingParticipant[]
  instructedSessions         TrainingSession[]              @relation("TrainingInstructor")
  assignedUserRoles          UserRole[]                     @relation("UserRoleAssigner")
  roles                      UserRole[]
  mfaSessions                MfaSession[]
  securityEvents             SecurityEvent[]                @relation("SecurityEventActor")
  department                 Department?                    @relation(fields: [departmentId], references: [id])
  organization               Organization                   @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @db.Uuid
  name           String                 @db.VarChar(100)
  description    String?
  isSystem       Boolean                @default(false)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  distributions  DocumentDistribution[]
  permissions    RolePermission[]
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  roleId         String    @db.Uuid
  assignedBy     String    @db.Uuid
  assignedAt     DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime? @db.Timestamptz(6)
  assignedByUser User      @relation("UserRoleAssigner", fields: [assignedBy], references: [id])
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model MfaCredential {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @unique @db.Uuid
  secret     String    @db.VarChar(255)
  isActive   Boolean   @default(true)
  enrolledAt DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_recovery_codes")
}

model RefreshToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  tokenHash      String    @db.VarChar(255)
  userAgent      String?
  ipAddress      String?   @db.VarChar(45)
  expiresAt      DateTime  @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  replacedBy     String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model FileAsset {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String             @db.Uuid
  storageProvider  StorageProvider    @default(S3)
  bucketName       String             @db.VarChar(100)
  objectKey        String             @unique @db.VarChar(500)
  originalFilename String             @db.VarChar(500)
  mimeType         String             @db.VarChar(100)
  fileSizeBytes    BigInt
  sha256Hash       String             @db.VarChar(64)
  metadata         Json?              @db.Json
  uploadedById     String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?          @db.Timestamptz(6)
  actionEvidence   ActionEvidence[]
  auditEvidence    AuditEvidence[]
  documentVersions DocumentVersion[]
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy       User               @relation("FileUploader", fields: [uploadedById], references: [id])
  trainingEvidence TrainingEvidence[]

  @@index([organizationId, createdAt])
  @@map("file_assets")
}

model Document {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                  @db.Uuid
  documentTypeId   String                  @db.Uuid
  code             String                  @db.VarChar(100)
  title            String                  @db.VarChar(300)
  description      String?
  processId        String?                 @db.Uuid
  departmentId     String?                 @db.Uuid
  ownerId          String                  @db.Uuid
  responsibleId    String                  @db.Uuid
  classification   DocumentClassification  @default(INTERNAL)
  confidentiality  DocumentConfidentiality @default(CONFIDENTIAL)
  status           DocumentStatus          @default(DRAFT)
  currentVersionId String?                 @unique @db.Uuid
  issueDate        DateTime?               @db.Date
  reviewDate       DateTime?               @db.Date
  nextReviewDate   DateTime?               @db.Date
  createdById      String                  @db.Uuid
  updatedById      String                  @db.Uuid
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?               @db.Timestamptz(6)
  distributions    DocumentDistribution[]
  versions         DocumentVersion[]
  createdBy        User                    @relation("DocumentCreator", fields: [createdById], references: [id])
  currentVersion   DocumentVersion?        @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id])
  department       Department?             @relation(fields: [departmentId], references: [id])
  documentType     DocumentType            @relation(fields: [documentTypeId], references: [id])
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User                    @relation("DocumentOwner", fields: [ownerId], references: [id])
  process          Process?                @relation(fields: [processId], references: [id])
  responsible      User                    @relation("DocumentResponsible", fields: [responsibleId], references: [id])
  updatedBy        User                    @relation("DocumentUpdater", fields: [updatedById], references: [id])
  relatedTrainings TrainingCourse[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, nextReviewDate])
  @@map("documents")
}

model DocumentType {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique @db.VarChar(100)
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  documents   Document[]

  @@map("document_types")
}

model DocumentVersion {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String                 @db.Uuid
  organizationId String                 @db.Uuid
  versionMajor   Int                    @default(1)
  versionMinor   Int                    @default(0)
  versionLabel   String                 @db.VarChar(20)
  fileAssetId    String                 @db.Uuid
  fileHash       String                 @db.VarChar(64)
  changeReason   String
  status         DocumentStatus         @default(DRAFT)
  createdById    String                 @db.Uuid
  approvedById   String?                @db.Uuid
  approvedAt     DateTime?              @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime?              @updatedAt @db.Timestamptz(6)
  approvals      DocumentApproval[]
  distributions  DocumentDistribution[]
  reviewers      DocumentReviewer[]
  approvedBy     User?                  @relation("DocumentVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy      User                   @relation("DocumentVersionCreator", fields: [createdById], references: [id])
  document       Document               @relation(fields: [documentId], references: [id])
  fileAsset      FileAsset              @relation(fields: [fileAssetId], references: [id])
  organization   Organization           @relation(fields: [organizationId], references: [id])
  parentDocument Document?              @relation("CurrentDocumentVersion")

  @@unique([documentId, versionMajor, versionMinor])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentReviewer {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentVersionId String          @db.Uuid
  organizationId    String          @db.Uuid
  userId            String          @db.Uuid
  status            ReviewStatus    @default(PENDING)
  completedAt       DateTime?       @db.Timestamptz(6)
  comment           String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id])

  @@unique([documentVersionId, userId])
  @@map("document_reviewers")
}

model DocumentApproval {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentVersionId String          @db.Uuid
  organizationId    String          @db.Uuid
  userId            String          @db.Uuid
  status            ApprovalStatus  @default(PENDING)
  comment           String?
  decidedAt         DateTime?       @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id])

  @@unique([documentVersionId, userId])
  @@map("document_approvals")
}

model DocumentDistribution {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId             String                    @db.Uuid
  documentVersionId      String                    @db.Uuid
  organizationId         String                    @db.Uuid
  assignedToUserId       String?                   @db.Uuid
  assignedToDepartmentId String?                   @db.Uuid
  assignedToRoleId       String?                   @db.Uuid
  status                 DistributionStatus        @default(PENDING)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(6)
  acknowledgements       DocumentAcknowledgement[]
  assignedToDepartment   Department?               @relation(fields: [assignedToDepartmentId], references: [id])
  assignedToRole         Role?                     @relation(fields: [assignedToRoleId], references: [id])
  assignedToUser         User?                     @relation(fields: [assignedToUserId], references: [id])
  document               Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion        DocumentVersion           @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
  @@map("document_distribution")
}

model DocumentAcknowledgement {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentDistributionId String               @db.Uuid
  organizationId         String               @db.Uuid
  userId                 String               @db.Uuid
  ipAddress              String?              @db.VarChar(45)
  userAgent              String?
  acknowledgedAt         DateTime             @default(now()) @db.Timestamptz(6)
  documentDistribution   DocumentDistribution @relation(fields: [documentDistributionId], references: [id], onDelete: Cascade)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User                 @relation(fields: [userId], references: [id])

  @@unique([documentDistributionId, userId])
  @@map("document_acknowledgements")
}

model ProcessRequirementMap {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processId      String              @db.Uuid
  requirementId  String              @db.Uuid
  organizationId String              @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process        Process             @relation(fields: [processId], references: [id], onDelete: Cascade)
  requirement    StandardRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([processId, requirementId])
  @@map("process_requirement_map")
}

model Process {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                  @db.Uuid
  areaId          String?                 @db.Uuid
  parentProcessId String?                 @db.Uuid
  code            String                  @db.VarChar(50)
  name            String                  @db.VarChar(255)
  description     String?
  ownerId         String?                 @db.Uuid
  processType     String?                 @db.VarChar(50)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  audits          Audit[]
  documents       Document[]
  indicators      Indicator[]
  nonconformities Nonconformity[]
  requirementMaps ProcessRequirementMap[]
  area            Area?                   @relation(fields: [areaId], references: [id])
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?                   @relation(fields: [ownerId], references: [id])
  parentProcess   Process?                @relation("ProcessHierarchy", fields: [parentProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childProcesses  Process[]               @relation("ProcessHierarchy")
  risks           Risk[]
  trainingCourses TrainingCourse[]

  @@unique([organizationId, code])
  @@map("processes")
}

model Area {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  parentAreaId   String?      @db.Uuid
  name           String       @db.VarChar(150)
  code           String?      @db.VarChar(50)
  description    String?
  managerId      String?      @db.Uuid
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  manager        User?        @relation(fields: [managerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentArea     Area?        @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childAreas     Area[]       @relation("AreaHierarchy")
  processes      Process[]

  @@unique([organizationId, name])
  @@map("areas")
}

model AuditEvidence {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  auditId        String       @db.Uuid
  userId         String       @db.Uuid
  fileAssetId    String       @db.Uuid
  description    String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  audit          Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset    @relation(fields: [fileAssetId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@map("audit_evidence")
}

model ActionEvidence {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @db.Uuid
  correctiveActionId String           @db.Uuid
  userId             String           @db.Uuid
  fileAssetId        String           @db.Uuid
  description        String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
