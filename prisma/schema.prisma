// ============================================================================
// SCHEMA DECISIONS
// ============================================================================
//
// Las siguientes decisiones no pueden representarse directamente en Prisma
// y deberán resolverse posteriormente mediante migraciones SQL:
//
// 1. CHECK CONSTRAINTS:
//    - document_versions: version_major >= 1, version_minor >= 0
//    - audit_programs: period_end >= period_start
//    - indicator_measurements: measurement_date no futura (si aplica)
//    - training_sessions: scheduled_at no pasada (si aplica)
//    - risks: score dentro de rango válido según matriz configurada
//
// 2. ROW LEVEL SECURITY (RLS):
//    - Políticas RLS por tenant para todas las tablas tenant-scoped.
//    - Política append-only para audit_logs y electronic_signature_events.
//    - Contexto por conexión: SET LOCAL app.current_organization_id.
//
// 3. AUDIT LOG IMMUTABILITY:
//    - Permisos PostgreSQL que impidan UPDATE/DELETE desde rol runtime.
//    - Triggers de validación de event_hash.
//    - Restricted runtime role separado de migration role.
//
// 4. PARTIAL UNIQUE INDEXES:
//    - users: único por (organization_id, email) donde deleted_at IS NULL.
//    - documents: único por (organization_id, code) donde deleted_at IS NULL.
//    - Estas restricciones requieren índices parciales en PostgreSQL.
//
// 5. EXTENDED UNIQUE CONSTRAINTS:
//    - document_distribution: UNIQUE(document_version_id, assigned_to_user_id, assigned_to_department_id, assigned_to_role_id)
//      para evitar distribuciones duplicadas al mismo destinatario.
//    - Se recomienda implementar en migración SQL.
//
// 6. FOREIGN KEY NAMING:
//    - Prisma genera nombres de FK automáticamente.
//    - En migraciones posteriores se pueden renombrar para consistencia con DATABASE.md.
//
// 7. TRIGGERS:
//    - Trigger para updated_at en tablas que no usan @updatedAt.
//    - Trigger para calcular event_hash en audit_logs.
//    - Trigger para validar transiciones de estado.
//
// 8. ENUMS vs STRING:
//    - Se utilizan enums para estados cerrados y estables:
//      DocumentStatus, ApprovalStatus, ReviewStatus, DistributionStatus,
//      AuditStatus, NonconformityStatus, CorrectiveActionStatus,
//      RiskStatus, TrainingStatus, AttendanceStatus, IndicatorStatus,
//      NotificationChannel, NotificationStatus, AuditResult, StorageProvider.
//    - Se mantienen como String estados abiertos o evolutivos:
//      AuditProgram.status, Audit.auditType, AuditFinding.findingType,
//      AuditFinding.severity, Nonconformity.severity, Risk.riskType,
//      RootCauseAnalysis.methodology, RiskTreatment.strategy.
//    - Esto permite evolucionar catálogos sin migraciones de enum.
//
// 9. COMPOSITE PRIMARY KEYS:
//    - TrainingParticipant usa @@id([sessionId, userId]) para modelar
//      la clave compuesta definida en DATABASE.md.
//
// 10. SOFT DELETE:
//     - Solo User, Document y FileAsset incluyen deletedAt en Fase 1.
//     - Otras entidades pueden requerir soft delete según evolución del negocio.
//     - No se agrega deletedAt globalmente para evitar overhead innecesario.
//
// 11. AUDIT LOG PAYLOAD:
//     - El campo payload almacena JSONB con old_values/new_values.
//     - La estructura exacta del payload se define en capa de aplicación.
//
// ============================================================================

model MfaSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  sessionId      String    @db.VarChar(100)
  verified       Boolean   @default(false)
  expiresAt      DateTime  @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId, verified, expiresAt])
  @@map("mfa_sessions")
}

model SecurityEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  eventType      String   @db.VarChar(100)
  severity       String   @db.VarChar(20)
  description    String   @db.Text
  metadata       Json     @default("{}") @db.Json
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.Text
  correlationId  String   @db.VarChar(100)
  previousHash   String?  @db.VarChar(64)
  eventHash      String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation("SecurityActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, eventType, severity])
  @@index([correlationId])
  @@map("security_events")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  key            String   @db.VarChar(100)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(500)
  statusCode     Int?
  responseBody   Json?
  createdAt      DateTime @default(now()) @db.Timestamptz
  expiresAt      DateTime @db.Timestamptz

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
