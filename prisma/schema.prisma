// QMS Platform — Prisma Schema
// Basado en: ARCHITECTURE.md, DATABASE.md, SECURITY.md
// PostgreSQL 16+
// Multi-tenant con RLS preparado

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  REJECTED
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  CURRENT
  OBSOLETE
  CANCELLED
}

enum DocumentClassification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentConfidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum DistributionStatus {
  PENDING
  ACKNOWLEDGED
}

enum ReviewStatus {
  PENDING
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingType {
  CONFORMITY
  NON_CONFORMITY
  OBSERVATION
  OPPORTUNITY
}

enum NonconformityStatus {
  OPEN
  ANALYSIS
  ACTION_PLANNED
  IMPLEMENTATION
  VERIFICATION
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CorrectiveActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
}

enum RootCauseMethodology {
  FIVE_WHY
  ISHIKAWA
  FREE_FORM
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  TREATMENT_PLANNED
  UNDER_CONTROL
  CLOSED
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  JUSTIFIED
}

enum IndicatorStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum StorageProvider {
  S3
  MINIO
  LOCAL
}

// ============================================================================
// GLOBALES (sin organization_id)
// ============================================================================

model Standard {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  version     String?  @db.VarChar(20)
  isActive    Boolean  @default(true) @db.Boolean
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  requirements      StandardRequirement[]
  organizationLinks OrganizationStandard[]

  @@map("standards")
}

model StandardRequirement {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standardId          String   @db.Uuid
  code                String   @db.VarChar(50)
  title               String   @db.VarChar(300)
  description         String?  @db.Text
  clause              String?  @db.VarChar(50)
  parentRequirementId String?  @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz

  standard            Standard                @relation(fields: [standardId], references: [id], onDelete: Cascade)
  parentRequirement   StandardRequirement?    @relation("RequirementHierarchy", fields: [parentRequirementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childRequirements   StandardRequirement[]   @relation("RequirementHierarchy")
  processLinks        ProcessRequirementMap[]
  auditChecklistItems AuditChecklistItem[]
  findings            AuditFinding[]

  @@unique([standardId, code])
  @@map("standard_requirements")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// ============================================================================
// MULTI-TENANCY & AUTH
// ============================================================================

model Organization {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(200)
  taxId        String?  @db.VarChar(50)
  email        String?  @db.VarChar(200)
  phone        String?  @db.VarChar(50)
  address      String?  @db.Text
  timezone     String   @default("UTC") @db.VarChar(50)
  locale       String   @default("es") @db.VarChar(10)
  logoUrl      String?  @db.Text
  primaryColor String?  @db.VarChar(7)
  isActive     Boolean  @default(true) @db.Boolean
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  settings                      OrganizationSetting[]
  standards                     OrganizationStandard[]
  departments                   Department[]
  users                         User[]
  roles                         Role[]
  documents                     Document[]
  documentVersions              DocumentVersion[]
  documentReviewers             DocumentReviewer[]
  documentApprovals             DocumentApproval[]
  distributions                 DocumentDistribution[]
  documentAcknowledgements      DocumentAcknowledgement[]
  audits                        Audit[]
  auditPrograms                 AuditProgram[]
  auditChecklists               AuditChecklist[]
  auditFindings                 AuditFinding[]
  nonconformities               Nonconformity[]
  rootCauseAnalyses             RootCauseAnalysis[]
  correctiveActions             CorrectiveAction[]
  correctiveActionVerifications CorrectiveActionVerification[]
  risks                         Risk[]
  riskAssessments               RiskAssessment[]
  riskTreatments                RiskTreatment[]
  fileAssets                    FileAsset[]
  processes                     Process[]
  areas                         Area[]
  processRequirementMaps        ProcessRequirementMap[]
  auditEvidences                AuditEvidence[]
  actionEvidences               ActionEvidence[]
  riskControls                  RiskControl[]
  trainingEvidences             TrainingEvidence[]
  trainingCourses               TrainingCourse[]
  trainingSessions              TrainingSession[]
  indicators                    Indicator[]
  indicatorMeasurements         IndicatorMeasurement[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  electronicSignatures          ElectronicSignatureEvent[]
  auditLogs                     AuditLog[]
  securityEvents                SecurityEvent[]
  mfaSessions                   MfaSession[]

  @@map("organizations")
}

model OrganizationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  key            String   @db.VarChar(100)
  value          Json     @default("{}") @db.Json
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model OrganizationStandard {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  standardId     String    @db.Uuid
  adoptedAt      DateTime? @db.Date
  isActive       Boolean   @default(true) @db.Boolean
  configuration  Json      @default("{}") @db.Json
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard     @relation(fields: [standardId], references: [id], onDelete: Restrict)

  @@unique([organizationId, standardId])
  @@map("organization_standards")
}

model Department {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @db.Uuid
  name               String   @db.VarChar(150)
  description        String?  @db.Text
  parentDepartmentId String?  @db.Uuid
  isActive           Boolean  @default(true) @db.Boolean
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment Department?            @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childDepartments Department[]           @relation("DepartmentHierarchy")
  users            User[]
  distributions    DocumentDistribution[]
  documents        Document[]

  @@unique([organizationId, name])
  @@map("departments")
}

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @db.Uuid
  email               String    @db.VarChar(200)
  passwordHash        String    @db.VarChar(255)
  firstName           String    @db.VarChar(100)
  lastName            String    @db.VarChar(100)
  departmentId        String?   @db.Uuid
  mfaEnabled          Boolean   @default(false) @db.Boolean
  mfaSecret           String?   @db.VarChar(255)
  mfaBackupCodes      Json?     @db.Json
  lastLoginAt         DateTime? @db.Timestamptz
  lastLoginIp         String?   @db.VarChar(45)
  isActive            Boolean   @default(true) @db.Boolean
  isLocked            Boolean   @default(false) @db.Boolean
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz
  deletedAt           DateTime? @db.Timestamptz

  organization               Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department                 Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles                      UserRole[]
  assignedUserRoles          UserRole[]                     @relation("UserRoleAssigner")
  createdDocuments           Document[]                     @relation("DocumentCreator")
  updatedDocuments           Document[]                     @relation("DocumentUpdater")
  ownedDocuments             Document[]                     @relation("DocumentOwner")
  responsibleDocuments       Document[]                     @relation("DocumentResponsible")
  createdDocumentVersions    DocumentVersion[]              @relation("DocumentVersionCreator")
  approvedDocumentVersions   DocumentVersion[]              @relation("DocumentVersionApprover")
  documentReviewers          DocumentReviewer[]
  documentApprovals          DocumentApproval[]
  documentAcknowledgements   DocumentAcknowledgement[]
  assignedDistributions      DocumentDistribution[]
  leadAudits                 Audit[]                        @relation("AuditLead")
  identifiedFindings         AuditFinding[]                 @relation("FindingIdentifier")
  auditEvidence              AuditEvidence[]
  responsibleNonconformities Nonconformity[]                @relation("NonconformityResponsible")
  closedNonconformities      Nonconformity[]                @relation("NonconformityClosedBy")
  correctiveActions          CorrectiveAction[]
  rootCauseAnalyses          RootCauseAnalysis[]
  actionEvidence             ActionEvidence[]
  verifications              CorrectiveActionVerification[] @relation("VerificationPerformer")
  risks                      Risk[]                         @relation("RiskOwner")
  riskControls               RiskControl[]
  treatments                 RiskTreatment[]                @relation("RiskTreatmentResponsible")
  assessments                RiskAssessment[]
  managedAreas               Area[]
  ownedProcesses             Process[]
  managedAuditPrograms       AuditProgram[]
  responsibleIndicators      Indicator[]                    @relation("IndicatorResponsible")
  uploadedFiles              FileAsset[]                    @relation("FileUploader")
  refreshTokens              RefreshToken[]
  mfaCredential              MfaCredential?
  mfaRecoveryCodes           MfaRecoveryCode[]
  instructedSessions         TrainingSession[]              @relation("TrainingInstructor")
  trainingParticipants       TrainingParticipant[]
  indicatorMeasurements      IndicatorMeasurement[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  electronicSignatures       ElectronicSignatureEvent[]
  auditLogs                  AuditLog[]                     @relation("AuditActor")
  securityEvents             SecurityEvent[]                @relation("SecurityActor")
  mfaSessions                MfaSession[]

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  isSystem       Boolean  @default(false) @db.Boolean
  isActive       Boolean  @default(true) @db.Boolean
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userRoles     UserRole[]
  distributions DocumentDistribution[]

  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  assignedBy String    @db.Uuid
  assignedAt DateTime  @default(now()) @db.Timestamptz
  expiresAt  DateTime? @db.Timestamptz

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User @relation("UserRoleAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ============================================================================
// CREDENCIALES & SESIONES
// ============================================================================

model MfaCredential {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  secret     String    @db.VarChar(255)
  isActive   Boolean   @default(true) @db.Boolean
  enrolledAt DateTime? @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @db.VarChar(255)
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_recovery_codes")
}

model RefreshToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  tokenHash      String    @db.VarChar(255)
  userAgent      String?   @db.Text
  ipAddress      String?   @db.VarChar(45)
  expiresAt      DateTime  @db.Timestamptz
  revokedAt      DateTime? @db.Timestamptz
  replacedBy     String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// ARCHIVOS CENTRALIZADOS
// ============================================================================

model FileAsset {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String          @db.Uuid
  storageProvider  StorageProvider @default(S3)
  bucketName       String          @db.VarChar(100)
  objectKey        String          @db.VarChar(500)
  originalFilename String          @db.VarChar(500)
  mimeType         String          @db.VarChar(100)
  fileSizeBytes    BigInt          @db.BigInt
  sha256Hash       String          @db.VarChar(64)
  metadata         Json?           @db.Json
  uploadedById     String          @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz
  updatedAt        DateTime        @updatedAt @db.Timestamptz
  deletedAt        DateTime?       @db.Timestamptz

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy       User               @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  documentVersions DocumentVersion[]
  auditEvidence    AuditEvidence[]
  actionEvidence   ActionEvidence[]
  trainingEvidence TrainingEvidence[]

  @@unique([objectKey])
  @@index([organizationId, createdAt])
  @@map("file_assets")
}

// ============================================================================
// DOCUMENTACIÓN QMS
// ============================================================================

model Document {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                  @db.Uuid
  documentTypeId   String                  @db.Uuid
  code             String                  @db.VarChar(100)
  title            String                  @db.VarChar(300)
  description      String?                 @db.Text
  processId        String?                 @db.Uuid
  departmentId     String?                 @db.Uuid
  ownerId          String                  @db.Uuid
  responsibleId    String                  @db.Uuid
  classification   DocumentClassification  @default(INTERNAL)
  confidentiality  DocumentConfidentiality @default(CONFIDENTIAL)
  status           DocumentStatus          @default(DRAFT)
  currentVersionId String?                 @unique @db.Uuid
  issueDate        DateTime?               @db.Date
  reviewDate       DateTime?               @db.Date
  nextReviewDate   DateTime?               @db.Date
  createdById      String                  @db.Uuid
  updatedById      String                  @db.Uuid
  createdAt        DateTime                @default(now()) @db.Timestamptz
  updatedAt        DateTime                @updatedAt @db.Timestamptz
  deletedAt        DateTime?               @db.Timestamptz

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType     DocumentType           @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  process          Process?               @relation(fields: [processId], references: [id], onDelete: SetNull)
  department       Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner            User                   @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  responsible      User                   @relation("DocumentResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdBy        User                   @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User                   @relation("DocumentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  currentVersion   DocumentVersion?       @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]
  distributions    DocumentDistribution[]
  relatedTrainings TrainingCourse[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, nextReviewDate])
  @@map("documents")
}

model DocumentType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @db.Boolean
  createdAt   DateTime @default(now()) @db.Timestamptz

  documents Document[]

  @@map("document_types")
}

model DocumentVersion {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String         @db.Uuid
  organizationId String         @db.Uuid
  versionMajor   Int            @default(1)
  versionMinor   Int            @default(0)
  versionLabel   String         @db.VarChar(20)
  fileAssetId    String         @db.Uuid
  fileHash       String         @db.VarChar(64)
  changeReason   String         @db.Text
  status         DocumentStatus @default(DRAFT)
  createdById    String         @db.Uuid
  approvedById   String?        @db.Uuid
  approvedAt     DateTime?      @db.Timestamptz
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz

  document       Document               @relation(fields: [documentId], references: [id], onDelete: Restrict)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fileAsset      FileAsset              @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  createdBy      User                   @relation("DocumentVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?                  @relation("DocumentVersionApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  reviewers      DocumentReviewer[]
  approvals      DocumentApproval[]
  distributions  DocumentDistribution[]
  parentDocument Document?              @relation("CurrentDocumentVersion")

  @@unique([documentId, versionMajor, versionMinor])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentReviewer {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentVersionId String       @db.Uuid
  organizationId    String       @db.Uuid
  userId            String       @db.Uuid
  status            ReviewStatus @default(PENDING)
  completedAt       DateTime?    @db.Timestamptz
  comment           String?      @db.Text
  createdAt         DateTime     @default(now()) @db.Timestamptz
  updatedAt         DateTime     @updatedAt @db.Timestamptz

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([documentVersionId, userId])
  @@map("document_reviewers")
}

model DocumentApproval {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentVersionId String         @db.Uuid
  organizationId    String         @db.Uuid
  userId            String         @db.Uuid
  status            ApprovalStatus @default(PENDING)
  comment           String?        @db.Text
  decidedAt         DateTime?      @db.Timestamptz
  createdAt         DateTime       @default(now()) @db.Timestamptz

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([documentVersionId, userId])
  @@map("document_approvals")
}

model DocumentDistribution {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId             String             @db.Uuid
  documentVersionId      String             @db.Uuid
  organizationId         String             @db.Uuid
  assignedToUserId       String?            @db.Uuid
  assignedToDepartmentId String?            @db.Uuid
  assignedToRoleId       String?            @db.Uuid
  status                 DistributionStatus @default(PENDING)
  createdAt              DateTime           @default(now()) @db.Timestamptz

  document             Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion      DocumentVersion           @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedToUser       User?                     @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToDepartment Department?               @relation(fields: [assignedToDepartmentId], references: [id], onDelete: SetNull)
  assignedToRole       Role?                     @relation(fields: [assignedToRoleId], references: [id], onDelete: SetNull)
  acknowledgements     DocumentAcknowledgement[]

  @@index([organizationId, documentId])
  @@map("document_distribution")
}

model DocumentAcknowledgement {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentDistributionId String   @db.Uuid
  organizationId         String   @db.Uuid
  userId                 String   @db.Uuid
  ipAddress              String?  @db.VarChar(45)
  userAgent              String?  @db.Text
  acknowledgedAt         DateTime @default(now()) @db.Timestamptz

  documentDistribution DocumentDistribution @relation(fields: [documentDistributionId], references: [id], onDelete: Cascade)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([documentDistributionId, userId])
  @@map("document_acknowledgements")
}

// ============================================================================
// MAPEO PROCESO-REQUISITO (para trazabilidad ISO)
// ============================================================================

model ProcessRequirementMap {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processId      String   @db.Uuid
  requirementId  String   @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  process      Process             @relation(fields: [processId], references: [id], onDelete: Cascade)
  requirement  StandardRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([processId, requirementId])
  @@map("process_requirement_map")
}

// ============================================================================
// ESTRUCTURA ORGANIZACIONAL (procesos requeridos por auditorías y riesgos)
// ============================================================================

model Process {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  areaId          String?  @db.Uuid
  parentProcessId String?  @db.Uuid
